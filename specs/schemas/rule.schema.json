{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "candidate",
        "approved",
        "retired"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "const": "static_upgrade_plan"
    },
    "support_edge_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "applies": {
      "$ref": "#/$defs/expression"
    },
    "assertion": {
      "$ref": "#/$defs/expression"
    },
    "severity": {
      "enum": [
        "blocker",
        "warning",
        "info"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "review_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phase": {
          "enum": [
            "before_upgrade",
            "during_upgrade",
            "after_upgrade",
            "manual_review"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "docs_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "executable": {
          "const": false
        }
      },
      "required": [
        "phase",
        "summary",
        "docs_refs",
        "executable"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "synthetic",
    "status",
    "title",
    "scope",
    "support_edge_ids",
    "applies",
    "assertion",
    "severity",
    "evidence_refs",
    "review_ref",
    "supersedes",
    "remediation"
  ],
  "$defs": {
    "atom": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fact": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "in",
            "version_lt",
            "version_lte",
            "version_gt",
            "version_gte"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "minItems": 1
            }
          ]
        }
      },
      "required": [
        "fact",
        "op",
        "value"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "in"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "version_lt",
                  "version_lte",
                  "version_gt",
                  "version_gte"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "$ref": "#/$defs/atom"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1,
              "maxItems": 64
            }
          },
          "required": [
            "all"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1,
              "maxItems": 64
            }
          },
          "required": [
            "any"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "not"
          ]
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        }
      },
      "then": {
        "properties": {
          "review_ref": {
            "type": "string",
            "minLength": 1
          },
          "synthetic": {
            "const": false
          }
        }
      }
    }
  ]
}
