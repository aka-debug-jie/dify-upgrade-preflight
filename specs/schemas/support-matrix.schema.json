{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "approved_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_version": {
            "type": "string",
            "minLength": 1
          },
          "target_version": {
            "type": "string",
            "minLength": 1
          },
          "source_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "target_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "deployment_profile": {
            "type": "string",
            "minLength": 1
          },
          "compose_version": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "const": "static_upgrade_plan"
          },
          "required_facts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "case_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "approval_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "source_version",
          "target_version",
          "source_commit",
          "target_commit",
          "deployment_profile",
          "compose_version",
          "scope",
          "required_facts",
          "rule_ids",
          "case_ids",
          "approval_ref"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "catalog_version",
    "approved_edges"
  ]
}
